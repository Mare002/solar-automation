      "id": "a1b2c3d4-0000-4000-8000-00000000c000",
      "name": "Result: Manual review",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        2016,
        560
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Hard gate before anything is created or sent. The AI chatbot can call this\n// workflow with invented values, so every field is checked here, in code, not by the LLM.\nconst ROOF = ['Sloped (pitched)', 'Flat', 'Metal', 'Tile', 'Concrete', 'Other'];\nconst ORIENT = ['South', 'Southeast', 'Southwest', 'East', 'West', 'Northeast', 'Northwest', 'North'];\nconst REGION = ['Bratislava', 'Trnava', 'Nitra', 'Trenčín', 'Žilina', 'Banská Bystrica', 'Prešov', 'Košice', 'Other'];\nconst pick = (list, v) => list.find(x => x.toLowerCase() === String(v ?? '').trim().toLowerCase());\nconst plain = s => String(s ?? '').trim().toLowerCase().normalize('NFKD').replace(/[̀-ͯ]/g, '');\n\nconst i = $json;\nconst errors = [];\nconst source = i.source || 'form';\n\nconst name = String(i.name ?? '').trim();\nif (!name) errors.push('name: missing');\nelse if (source === 'chat' && name.split(/\\s+/).length < 2) errors.push('name: ask the customer for their first name and surname');\n\nconst email = String(i.email ?? '').trim();\nif (!/^[^\\s@]+@[^\\s@]+\\.[a-z]{2,}$/i.test(email)) errors.push('email: not a valid address, ask the customer again');\nelse if (/@(example\\.(com|org|net)|test\\.[a-z]+|[^@]*\\.(test|example|invalid|localhost))$/i.test(email) || /^(test|example|placeholder|user|name)@/i.test(email))\n  errors.push('email: looks like a placeholder, ask the customer for their real email');\n\nconst kwh = Number(i.monthly_kwh);\nif (!(kwh >= 50 && kwh <= 5000)) errors.push('monthly_kwh: must be a number between 50 and 5000');\n\nconst roof = pick(ROOF, i.roof_type);\nif (!roof) errors.push('roof_type: must be one of ' + ROOF.join(', '));\nconst orientation = pick(ORIENT, i.orientation);\nif (!orientation) errors.push('orientation: must be one of ' + ORIENT.join(', '));\nconst location = pick(REGION, i.location);\nif (!location) errors.push('location: must be one of ' + REGION.join(', '));\n\nconst b = plain(i.battery);\nconst battery = ['yes', 'ano', 'a', 'true', '1'].includes(b) ? 'Yes' : ['no', 'nie', 'n', 'false', '0'].includes(b) ? 'No' : null;\nif (!battery) errors.push('battery: must be Yes or No');\n\n// Chat only: the customer's last message (passed by n8n, not by the AI) must confirm the summary.\nif (source === 'chat') {\n  const c = plain(i.confirmation);\n  const ok = /^(ano|a|jo|yes|y|ok|okay|sure|spravne|suhlas|suhlasim|potvrdzujem|presne|ano[\\s,!.].*|yes[\\s,!.].*|je to spravne.*|vsetko sedi.*|sedi.*)$/.test(c);\n  if (!ok) errors.push('not_confirmed: show the summary of all answers and wait until the customer confirms it, then call create_quote');\n}\n\nreturn {\n  json: {\n    name, email, phone: String(i.phone ?? '').trim(), monthly_kwh: kwh,\n    roof_type: roof ?? i.roof_type, orientation: orientation ?? i.orientation,\n    location: location ?? i.location, battery: battery ?? i.battery, source,\n    valid: errors.length === 0, errors,\n  },\n};"
      },
      "id": "a1b2c3d4-0000-4000-8000-00000000e001",
      "name": "Validate Input",
