# Copy this file to .env and fill in real values. .env is gitignored.
# Keep a copy of N8N_ENCRYPTION_KEY somewhere outside this machine
# (password manager). It is the single thing that makes n8n credential
# backups restorable.

POSTGRES_USER=odoo
POSTGRES_PASSWORD=change_me_before_first_boot

# Generate once, then never change it:
#   PowerShell: [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))
#   Linux/mac:  openssl rand -base64 32
N8N_ENCRYPTION_KEY=paste_generated_key_here

# Pin this after the first successful boot so a future `docker compose pull`
# cannot silently upgrade n8n and break your workflows.
# Find the running version at http://localhost:5678 (bottom-left menu > About).
# The workflows in this repo were built and tested on 2.38.7.
N8N_VERSION=2.38.7

# Groq API key (free at https://console.groq.com) and the Gmail App Password for SMTP
# are not read by compose; enter them in the n8n credential UI. Kept here as a reminder.
# GROQ_API_KEY=
